{%- comment -%}
  Featured Collections Section
  Grid of collection cards with images, titles, product count, and shop buttons.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign heading_alignment = section.settings.heading_alignment | default: 'center'
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign columns_mobile = section.settings.columns_mobile | default: '1'
  assign show_product_count = section.settings.show_product_count
-%}

<section class="featured-collections section">
  <div class="container">
    {%- if heading != blank -%}
      <div class="section__header text-{{ heading_alignment }}">
        <h2 class="section__title">{{ heading }}</h2>
      </div>
    {%- endif -%}

    <div 
      class="featured-collections__grid grid"
      style="--columns-desktop: {{ columns_desktop }}; --columns-mobile: {{ columns_mobile }};"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign custom_image = block.settings.custom_image
          assign button_text = block.settings.button_text | default: 'Shop Now'
          
          if custom_image != blank
            assign collection_image = custom_image
          elsif collection.image != blank
            assign collection_image = collection.image
          elsif collection.products.first.featured_image != blank
            assign collection_image = collection.products.first.featured_image
          else
            assign collection_image = blank
          endif
        -%}
        
        <div class="featured-collections__item" {{ block.shopify_attributes }}>
          <a 
            href="{{ collection.url | default: routes.all_products_collection_url }}" 
            class="collection-card"
            aria-label="{{ collection.title | default: 'Collection' | append: ' - ' | append: button_text }}"
          >
            <div class="collection-card__image-wrapper">
              {%- if collection_image != blank -%}
                <img
                  class="collection-card__image"
                  src="{{ collection_image | image_url: width: 800 }}"
                  alt="{{ collection_image.alt | default: collection.title | escape }}"
                  width="{{ collection_image.width }}"
                  height="{{ collection_image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="collection-card__placeholder">
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
              <div class="collection-card__overlay"></div>
            </div>
            
            <div class="collection-card__content">
              <h3 class="collection-card__title">
                {{ collection.title | default: 'Collection Title' }}
              </h3>
              
              {%- if show_product_count and collection != blank -%}
                <p class="collection-card__count">
                  {{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}
                </p>
              {%- endif -%}
              
              <span class="collection-card__button btn btn--outline-white btn--sm">
                {{ button_text }}
              </span>
            </div>
          </a>
        </div>
      {%- else -%}
        {%- comment -%} Default items when no blocks exist {%- endcomment -%}
        {%- for i in (1..3) -%}
          <div class="featured-collections__item">
            <div class="collection-card">
              <div class="collection-card__image-wrapper">
                <div class="collection-card__placeholder">
                  {{ 'collection-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
                <div class="collection-card__overlay"></div>
              </div>
              <div class="collection-card__content">
                <h3 class="collection-card__title">Collection {{ i }}</h3>
                <p class="collection-card__count">0 products</p>
                <span class="collection-card__button btn btn--outline-white btn--sm">Shop Now</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "tag": "section",
  "class": "section-featured-collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image",
          "info": "Optional: override the collection image"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop Now"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "button_text": "Shop Idols"
          }
        },
        {
          "type": "collection",
          "settings": {
            "button_text": "Shop Puja Items"
          }
        },
        {
          "type": "collection",
          "settings": {
            "button_text": "Shop Accessories"
          }
        }
      ]
    }
  ]
}
{% endschema %}
