{%- comment -%}
  Main Blog Section
  Renders the blog page with article cards grid.
{%- endcomment -%}

{%- liquid
  assign articles_per_page = section.settings.articles_per_page | default: 12
  assign show_author = section.settings.show_author
  assign show_date = section.settings.show_date
  assign show_featured_image = section.settings.show_featured_image
-%}

<section class="main-blog section">
  <div class="container">
    <header class="main-blog__header">
      <h1 class="main-blog__title">{{ blog.title }}</h1>
      {%- if blog.articles_count > 0 -%}
        <p class="main-blog__count">{{ 'blogs.articles_count' | t: count: blog.articles_count }}</p>
      {%- endif -%}
    </header>
    
    {%- paginate blog.articles by articles_per_page -%}
      {%- if blog.articles.size > 0 -%}
        <div class="main-blog__grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
          {%- for article in blog.articles -%}
            <article class="article-card">
              {%- if show_featured_image and article.image -%}
                <a href="{{ article.url }}" class="article-card__image-wrapper">
                  <img
                    class="article-card__image"
                    src="{{ article.image | image_url: width: 600 }}"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    width="{{ article.image.width }}"
                    height="{{ article.image.height }}"
                    loading="lazy"
                    decoding="async"
                  >
                </a>
              {%- endif -%}
              
              <div class="article-card__content">
                {%- if show_date or show_author -%}
                  <div class="article-card__meta">
                    {%- if show_date -%}
                      <time class="article-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                        {{ article.published_at | date: format: 'abbreviated_date' }}
                      </time>
                    {%- endif -%}
                    {%- if show_date and show_author -%}
                      <span class="article-card__meta-separator">•</span>
                    {%- endif -%}
                    {%- if show_author -%}
                      <span class="article-card__author">{{ article.author }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                
                <h2 class="article-card__title">
                  <a href="{{ article.url }}">{{ article.title }}</a>
                </h2>
                
                {%- if article.excerpt_or_content != blank -%}
                  <p class="article-card__excerpt">
                    {{ article.excerpt_or_content | strip_html | truncate: 150 }}
                  </p>
                {%- endif -%}
                
                <a href="{{ article.url }}" class="article-card__read-more">
                  {{ 'blogs.read_more' | t }}
                  {% render 'icon', name: 'arrow-right', size: 16 %}
                </a>
              </div>
            </article>
          {%- endfor -%}
        </div>
        
        {%- comment -%} Pagination {%- endcomment -%}
        {%- if paginate.pages > 1 -%}
          <nav class="main-blog__pagination pagination" aria-label="{{ 'blogs.pagination' | t }}">
            <ul class="pagination__list">
              {%- if paginate.previous -%}
                <li class="pagination__item">
                  <a href="{{ paginate.previous.url }}" class="pagination__link pagination__link--prev" aria-label="{{ 'blogs.previous_page' | t }}">
                    {% render 'icon', name: 'chevron-left', size: 16 %}
                    {{ 'blogs.previous' | t }}
                  </a>
                </li>
              {%- endif -%}
              
              {%- for part in paginate.parts -%}
                <li class="pagination__item">
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}" class="pagination__link">{{ part.title }}</a>
                  {%- else -%}
                    {%- if part.title == paginate.current_page -%}
                      <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
                    {%- else -%}
                      <span class="pagination__link pagination__link--ellipsis">{{ part.title }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </li>
              {%- endfor -%}
              
              {%- if paginate.next -%}
                <li class="pagination__item">
                  <a href="{{ paginate.next.url }}" class="pagination__link pagination__link--next" aria-label="{{ 'blogs.next_page' | t }}">
                    {{ 'blogs.next' | t }}
                    {% render 'icon', name: 'chevron-right', size: 16 %}
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="main-blog__empty">
          <p>{{ 'blogs.no_articles' | t }}</p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

<style>
  .main-blog__header {
    text-align: center;
    margin-bottom: var(--spacing-8);
  }
  
  .main-blog__title {
    margin-bottom: var(--spacing-2);
  }
  
  .main-blog__count {
    color: var(--color-gray-500);
    font-size: var(--font-size-sm);
  }
  
  .main-blog__grid {
    gap: var(--spacing-6);
  }
  
  /* Article Card */
  .article-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }
  
  .article-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }
  
  .article-card__image-wrapper {
    display: block;
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  
  .article-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }
  
  .article-card:hover .article-card__image {
    transform: scale(1.05);
  }
  
  .article-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: var(--spacing-5);
  }
  
  .article-card__meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    font-size: var(--font-size-sm);
    color: var(--color-gray-500);
    margin-bottom: var(--spacing-2);
  }
  
  .article-card__meta-separator {
    color: var(--color-gray-300);
  }
  
  .article-card__title {
    font-size: var(--font-size-xl);
    margin-bottom: var(--spacing-3);
    line-height: var(--line-height-tight);
  }
  
  .article-card__title a {
    color: var(--color-secondary);
    transition: color var(--transition-fast);
  }
  
  .article-card__title a:hover {
    color: var(--color-primary);
  }
  
  .article-card__excerpt {
    flex: 1;
    font-size: var(--font-size-sm);
    color: var(--color-gray-600);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--spacing-4);
  }
  
  .article-card__read-more {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-primary);
    transition: gap var(--transition-fast);
  }
  
  .article-card__read-more:hover {
    gap: var(--spacing-3);
  }
  
  .main-blog__pagination {
    margin-top: var(--spacing-12);
  }
  
  .main-blog__empty {
    text-align: center;
    padding: var(--spacing-12) var(--spacing-4);
    color: var(--color-gray-500);
  }
</style>

{% schema %}
{
  "name": "Main Blog",
  "tag": "section",
  "class": "main-blog-section",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_featured_image",
      "label": "Show featured image",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Main Blog"
    }
  ]
}
{% endschema %}
