{%- comment -%}
  Main Cart Section
  Renders the cart page with items, quantities, and checkout functionality.
{%- endcomment -%}

<section class="main-cart section">
  <div class="container">
    <h1 class="main-cart__title">{{ 'cart.title' | t }}</h1>
    
    {%- if cart.item_count > 0 -%}
      <form action="/cart" method="post" class="main-cart__form" data-cart-form>
        <div class="main-cart__layout">
          {%- comment -%} Cart Items {%- endcomment -%}
          <div class="main-cart__items" data-cart-items>
            <table class="main-cart__table">
              <thead class="main-cart__header hide-mobile">
                <tr>
                  <th class="main-cart__column main-cart__column--product">{{ 'cart.product' | t }}</th>
                  <th class="main-cart__column main-cart__column--price">{{ 'cart.price' | t }}</th>
                  <th class="main-cart__column main-cart__column--quantity">{{ 'cart.quantity' | t }}</th>
                  <th class="main-cart__column main-cart__column--total">{{ 'cart.total' | t }}</th>
                  <th class="main-cart__column main-cart__column--remove">
                    <span class="visually-hidden">{{ 'cart.remove' | t }}</span>
                  </th>
                </tr>
              </thead>
              <tbody class="main-cart__body">
                {%- for item in cart.items -%}
                  <tr class="main-cart__item" data-cart-item data-line-key="{{ item.key }}">
                    {%- comment -%} Product Info {%- endcomment -%}
                    <td class="main-cart__column main-cart__column--product">
                      <div class="main-cart__product">
                        <a href="{{ item.url }}" class="main-cart__product-image">
                          {%- if item.image -%}
                            <img
                              src="{{ item.image | image_url: width: 150 }}"
                              alt="{{ item.image.alt | default: item.title | escape }}"
                              width="75"
                              height="75"
                              loading="lazy"
                            >
                          {%- else -%}
                            <div class="main-cart__product-placeholder">
                              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                            </div>
                          {%- endif -%}
                        </a>
                        <div class="main-cart__product-info">
                          <a href="{{ item.url }}" class="main-cart__product-title">{{ item.product.title }}</a>
                          {%- unless item.product.has_only_default_variant -%}
                            <p class="main-cart__product-variant">{{ item.variant.title }}</p>
                          {%- endunless -%}
                          {%- if item.selling_plan_allocation -%}
                            <p class="main-cart__product-subscription">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                          {%- endif -%}
                          
                          {%- comment -%} Mobile Price {%- endcomment -%}
                          <div class="main-cart__product-price hide-desktop">
                            {%- if item.original_price != item.final_price -%}
                              <span class="price price--sale">{{ item.final_price | money }}</span>
                              <span class="price price--compare">{{ item.original_price | money }}</span>
                            {%- else -%}
                              <span class="price">{{ item.original_price | money }}</span>
                            {%- endif -%}
                          </div>
                        </div>
                      </div>
                    </td>
                    
                    {%- comment -%} Price {%- endcomment -%}
                    <td class="main-cart__column main-cart__column--price hide-mobile" data-item-price>
                      {%- if item.original_price != item.final_price -%}
                        <span class="price price--sale">{{ item.final_price | money }}</span>
                        <span class="price price--compare">{{ item.original_price | money }}</span>
                      {%- else -%}
                        <span class="price">{{ item.original_price | money }}</span>
                      {%- endif -%}
                    </td>
                    
                    {%- comment -%} Quantity {%- endcomment -%}
                    <td class="main-cart__column main-cart__column--quantity">
                      <div class="quantity-selector">
                        <button
                          type="button"
                          class="quantity-selector__btn"
                          data-quantity-decrease
                          data-line="{{ forloop.index }}"
                          aria-label="{{ 'cart.decrease_quantity' | t }}"
                        >
                          {% render 'icon', name: 'minus', size: 16 %}
                        </button>
                        <input
                          type="number"
                          class="quantity-selector__input"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          min="0"
                          data-quantity-input
                          data-line="{{ forloop.index }}"
                          aria-label="{{ 'cart.quantity_for' | t: product: item.title }}"
                        >
                        <button
                          type="button"
                          class="quantity-selector__btn"
                          data-quantity-increase
                          data-line="{{ forloop.index }}"
                          aria-label="{{ 'cart.increase_quantity' | t }}"
                        >
                          {% render 'icon', name: 'plus', size: 16 %}
                        </button>
                      </div>
                    </td>
                    
                    {%- comment -%} Line Total {%- endcomment -%}
                    <td class="main-cart__column main-cart__column--total hide-mobile" data-item-total>
                      <span class="price">{{ item.final_line_price | money }}</span>
                      {%- if item.original_line_price != item.final_line_price -%}
                        <span class="price price--compare">{{ item.original_line_price | money }}</span>
                      {%- endif -%}
                    </td>
                    
                    {%- comment -%} Remove Button {%- endcomment -%}
                    <td class="main-cart__column main-cart__column--remove">
                      <a
                        href="{{ item.url_to_remove }}"
                        class="main-cart__remove-btn"
                        data-remove-item
                        data-line="{{ forloop.index }}"
                        aria-label="{{ 'cart.remove_item' | t: product: item.title }}"
                      >
                        {% render 'icon', name: 'trash', size: 18 %}
                      </a>
                    </td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
          
          {%- comment -%} Cart Summary {%- endcomment -%}
          <div class="main-cart__summary">
            <div class="main-cart__summary-box">
              <h2 class="main-cart__summary-title">{{ 'cart.order_summary' | t }}</h2>
              
              {%- comment -%} Cart Note {%- endcomment -%}
              <div class="main-cart__note form-group">
                <label for="CartNote" class="form-label">{{ 'cart.note' | t }}</label>
                <textarea
                  id="CartNote"
                  class="form-textarea"
                  name="note"
                  rows="3"
                  placeholder="{{ 'cart.note_placeholder' | t }}"
                >{{ cart.note }}</textarea>
              </div>
              
              {%- comment -%} Subtotal {%- endcomment -%}
              <div class="main-cart__totals">
                <div class="main-cart__total-row">
                  <span class="main-cart__total-label">{{ 'cart.subtotal' | t }}</span>
                  <span class="main-cart__total-value" data-cart-subtotal>{{ cart.total_price | money }}</span>
                </div>
                
                {%- if cart.total_discount > 0 -%}
                  <div class="main-cart__total-row main-cart__total-row--discount">
                    <span class="main-cart__total-label">{{ 'cart.discount' | t }}</span>
                    <span class="main-cart__total-value">-{{ cart.total_discount | money }}</span>
                  </div>
                {%- endif -%}
                
                <p class="main-cart__shipping-note">
                  {{ 'cart.shipping_note' | t }}
                </p>
              </div>
              
              {%- comment -%} Checkout Buttons {%- endcomment -%}
              <div class="main-cart__actions">
                <button type="submit" name="update" class="btn btn--outline btn--full main-cart__update-btn">
                  {{ 'cart.update' | t }}
                </button>
                <button type="submit" name="checkout" class="btn btn--primary btn--lg btn--full main-cart__checkout-btn">
                  {{ 'cart.checkout' | t }} - {{ cart.total_price | money }}
                </button>
              </div>
              
              {%- comment -%} Continue Shopping {%- endcomment -%}
              <a href="{{ routes.all_products_collection_url }}" class="main-cart__continue-link">
                {% render 'icon', name: 'arrow-left', size: 16 %}
                {{ 'cart.continue_shopping' | t }}
              </a>
              
              {%- comment -%} Trust Badges {%- endcomment -%}
              <div class="main-cart__trust">
                <div class="main-cart__trust-item">
                  {% render 'icon', name: 'shield', size: 20 %}
                  <span>{{ 'cart.secure_checkout' | t }}</span>
                </div>
                <div class="main-cart__trust-item">
                  {% render 'icon', name: 'truck', size: 20 %}
                  <span>{{ 'cart.free_shipping' | t }}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </form>
    {%- else -%}
      {%- comment -%} Empty Cart {%- endcomment -%}
      <div class="main-cart__empty">
        <div class="main-cart__empty-icon">
          {% render 'icon', name: 'cart', size: 64 %}
        </div>
        <h2 class="main-cart__empty-title">{{ 'cart.empty_title' | t }}</h2>
        <p class="main-cart__empty-text">{{ 'cart.empty_text' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn--lg">
          {{ 'cart.start_shopping' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .main-cart__title {
    text-align: center;
    margin-bottom: var(--spacing-8);
  }
  
  .main-cart__layout {
    display: grid;
    gap: var(--spacing-8);
  }
  
  @media screen and (min-width: 1024px) {
    .main-cart__layout {
      grid-template-columns: 1fr 380px;
    }
  }
  
  /* Cart Table */
  .main-cart__table {
    width: 100%;
    border-collapse: collapse;
  }
  
  .main-cart__header {
    border-bottom: 2px solid var(--color-gray-200);
  }
  
  .main-cart__header th {
    padding: var(--spacing-3) var(--spacing-4);
    font-size: var(--font-size-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gray-600);
    text-align: left;
  }
  
  .main-cart__column--price,
  .main-cart__column--quantity,
  .main-cart__column--total {
    text-align: center;
  }
  
  .main-cart__column--remove {
    text-align: right;
  }
  
  .main-cart__item {
    border-bottom: 1px solid var(--color-gray-200);
  }
  
  .main-cart__column {
    padding: var(--spacing-4);
    vertical-align: middle;
  }
  
  /* Product Cell */
  .main-cart__product {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-4);
  }
  
  .main-cart__product-image {
    flex-shrink: 0;
    width: 75px;
    height: 75px;
    border-radius: var(--border-radius-md);
    overflow: hidden;
    background-color: var(--color-gray-100);
  }
  
  .main-cart__product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .main-cart__product-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .main-cart__product-placeholder svg {
    width: 50%;
    height: 50%;
    fill: var(--color-gray-300);
  }
  
  .main-cart__product-info {
    flex: 1;
    min-width: 0;
  }
  
  .main-cart__product-title {
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-1);
    display: block;
  }
  
  .main-cart__product-title:hover {
    color: var(--color-primary);
  }
  
  .main-cart__product-variant,
  .main-cart__product-subscription {
    font-size: var(--font-size-sm);
    color: var(--color-gray-500);
    margin-bottom: var(--spacing-1);
  }
  
  .main-cart__product-price {
    margin-top: var(--spacing-2);
  }
  
  /* Quantity */
  .main-cart__column--quantity .quantity-selector {
    justify-content: center;
  }
  
  /* Remove Button */
  .main-cart__remove-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-gray-400);
    border-radius: var(--border-radius-full);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }
  
  .main-cart__remove-btn:hover {
    color: var(--color-deep-red);
    background-color: var(--color-gray-100);
  }
  
  /* Summary Box */
  .main-cart__summary-box {
    background-color: var(--color-white);
    border-radius: var(--border-radius-lg);
    padding: var(--spacing-6);
    box-shadow: var(--shadow-md);
    position: sticky;
    top: calc(var(--header-height) + var(--spacing-4));
  }
  
  .main-cart__summary-title {
    font-size: var(--font-size-xl);
    margin-bottom: var(--spacing-4);
    padding-bottom: var(--spacing-4);
    border-bottom: 1px solid var(--color-gray-200);
  }
  
  .main-cart__note {
    margin-bottom: var(--spacing-4);
  }
  
  .main-cart__note textarea {
    min-height: 80px;
  }
  
  .main-cart__totals {
    padding: var(--spacing-4) 0;
    border-top: 1px solid var(--color-gray-200);
    border-bottom: 1px solid var(--color-gray-200);
    margin-bottom: var(--spacing-4);
  }
  
  .main-cart__total-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-2);
  }
  
  .main-cart__total-row:last-of-type {
    margin-bottom: 0;
  }
  
  .main-cart__total-label {
    font-weight: 600;
  }
  
  .main-cart__total-value {
    font-weight: 700;
    font-size: var(--font-size-lg);
  }
  
  .main-cart__total-row--discount .main-cart__total-value {
    color: var(--color-deep-red);
  }
  
  .main-cart__shipping-note {
    font-size: var(--font-size-sm);
    color: var(--color-gray-500);
    margin-top: var(--spacing-3);
    margin-bottom: 0;
  }
  
  .main-cart__actions {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    margin-bottom: var(--spacing-4);
  }
  
  .main-cart__continue-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    font-size: var(--font-size-sm);
    color: var(--color-gray-600);
    margin-bottom: var(--spacing-4);
  }
  
  .main-cart__continue-link:hover {
    color: var(--color-primary);
  }
  
  .main-cart__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-4);
    justify-content: center;
    padding-top: var(--spacing-4);
    border-top: 1px solid var(--color-gray-200);
  }
  
  .main-cart__trust-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    font-size: var(--font-size-sm);
    color: var(--color-gray-600);
  }
  
  .main-cart__trust-item svg {
    color: var(--color-primary);
  }
  
  /* Empty Cart */
  .main-cart__empty {
    text-align: center;
    padding: var(--spacing-16) var(--spacing-4);
    max-width: 500px;
    margin: 0 auto;
  }
  
  .main-cart__empty-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 120px;
    height: 120px;
    background-color: var(--color-gray-100);
    border-radius: var(--border-radius-full);
    margin-bottom: var(--spacing-6);
    color: var(--color-gray-400);
  }
  
  .main-cart__empty-title {
    margin-bottom: var(--spacing-3);
  }
  
  .main-cart__empty-text {
    color: var(--color-gray-600);
    margin-bottom: var(--spacing-6);
  }
  
  /* Mobile Responsive */
  @media screen and (max-width: 767px) {
    .main-cart__column {
      display: block;
      padding: var(--spacing-2) 0;
    }
    
    .main-cart__column--product {
      padding-top: var(--spacing-4);
    }
    
    .main-cart__item {
      display: flex;
      flex-wrap: wrap;
      padding: var(--spacing-4) 0;
    }
    
    .main-cart__column--product {
      flex: 1;
    }
    
    .main-cart__column--quantity {
      flex-basis: 100%;
      margin-top: var(--spacing-3);
    }
    
    .main-cart__column--quantity .quantity-selector {
      justify-content: flex-start;
    }
    
    .main-cart__column--remove {
      position: absolute;
      right: 0;
      top: var(--spacing-4);
    }
    
    .main-cart__item {
      position: relative;
    }
  }
</style>

{% schema %}
{
  "name": "Main Cart",
  "tag": "section",
  "class": "main-cart-section",
  "settings": [],
  "presets": [
    {
      "name": "Main Cart"
    }
  ]
}
{% endschema %}
