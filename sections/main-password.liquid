{%- comment -%}
  Main Password Section
  Renders the password page content for store opening.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign message = section.settings.message
  assign show_email_signup = section.settings.show_email_signup
-%}

<section class="main-password">
  <div class="main-password__container">
    <div class="main-password__content">
      {%- comment -%} Heading {%- endcomment -%}
      <h1 class="main-password__heading">
        {%- if heading != blank -%}
          {{ heading }}
        {%- else -%}
          {{ 'general.password_page.opening_soon' | t }}
        {%- endif -%}
      </h1>
      
      {%- comment -%} Message {%- endcomment -%}
      {%- if message != blank -%}
        <div class="main-password__message rte">
          {{ message }}
        </div>
      {%- else -%}
        <p class="main-password__message">{{ 'general.password_page.opening_soon_message' | t }}</p>
      {%- endif -%}
      
      {%- comment -%} Email Signup {%- endcomment -%}
      {%- if show_email_signup -%}
        <div class="main-password__signup">
          <p class="main-password__signup-text">{{ 'general.password_page.signup_text' | t }}</p>
          
          {%- form 'customer', class: 'main-password__signup-form' -%}
            <input type="hidden" name="contact[tags]" value="password-page">
            
            <div class="main-password__signup-fields">
              <label for="PasswordEmail" class="visually-hidden">{{ 'general.password_page.email_placeholder' | t }}</label>
              <input
                type="email"
                id="PasswordEmail"
                name="contact[email]"
                class="form-input main-password__signup-input"
                placeholder="{{ 'general.password_page.email_placeholder' | t }}"
                autocomplete="email"
                required
              >
              <button type="submit" class="btn btn--primary main-password__signup-submit">
                {{ 'general.password_page.signup_button' | t }}
              </button>
            </div>
            
            {%- if form.posted_successfully? -%}
              <p class="main-password__signup-success">{{ 'general.password_page.signup_success' | t }}</p>
            {%- endif -%}
            
            {%- if form.errors -%}
              <p class="main-password__signup-error">{{ form.errors.messages.email }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
      
      {%- comment -%} Password Entry {%- endcomment -%}
      <div class="main-password__entry">
        <button type="button" class="main-password__entry-toggle" data-password-toggle>
          {% render 'icon', name: 'lock', size: 16 %}
          {{ 'general.password_page.login_form_heading' | t }}
        </button>
        
        <div class="main-password__entry-form" id="PasswordFormContainer" hidden>
          {%- form 'storefront_password', class: 'main-password__form' -%}
            <div class="form-group">
              <label for="Password" class="visually-hidden">{{ 'general.password_page.password' | t }}</label>
              <input
                type="password"
                id="Password"
                name="password"
                class="form-input"
                placeholder="{{ 'general.password_page.password' | t }}"
                autofocus
              >
            </div>
            
            <button type="submit" class="btn btn--primary btn--full">
              {{ 'general.password_page.submit' | t }}
            </button>
            
            {%- if form.errors -%}
              <p class="main-password__form-error">{{ 'general.password_page.wrong_password' | t }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
      
      {%- comment -%} Social Links {%- endcomment -%}
      {%- if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_twitter_link != blank -%}
        <div class="main-password__social">
          <p class="main-password__social-text">{{ 'general.password_page.follow_us' | t }}</p>
          {% render 'social-icons' %}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .main-password {
    width: 100%;
    max-width: 500px;
    text-align: center;
  }
  
  .main-password__heading {
    font-size: var(--font-size-4xl);
    color: var(--color-secondary);
    margin-bottom: var(--spacing-4);
  }
  
  @media screen and (min-width: 768px) {
    .main-password__heading {
      font-size: var(--font-size-5xl);
    }
  }
  
  .main-password__message {
    font-size: var(--font-size-lg);
    color: var(--color-gray-600);
    margin-bottom: var(--spacing-8);
    line-height: var(--line-height-relaxed);
  }
  
  /* Email Signup */
  .main-password__signup {
    margin-bottom: var(--spacing-8);
  }
  
  .main-password__signup-text {
    font-size: var(--font-size-sm);
    color: var(--color-gray-600);
    margin-bottom: var(--spacing-4);
  }
  
  .main-password__signup-fields {
    display: flex;
    gap: var(--spacing-2);
  }
  
  @media screen and (max-width: 767px) {
    .main-password__signup-fields {
      flex-direction: column;
    }
  }
  
  .main-password__signup-input {
    flex: 1;
  }
  
  .main-password__signup-submit {
    flex-shrink: 0;
  }
  
  .main-password__signup-success {
    margin-top: var(--spacing-4);
    padding: var(--spacing-3);
    background-color: #D4EDDA;
    color: #155724;
    border-radius: var(--border-radius-md);
    font-size: var(--font-size-sm);
  }
  
  .main-password__signup-error {
    margin-top: var(--spacing-4);
    padding: var(--spacing-3);
    background-color: #F8D7DA;
    color: #721C24;
    border-radius: var(--border-radius-md);
    font-size: var(--font-size-sm);
  }
  
  /* Password Entry */
  .main-password__entry {
    margin-bottom: var(--spacing-8);
    padding-top: var(--spacing-6);
    border-top: 1px solid var(--color-gray-200);
  }
  
  .main-password__entry-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-2) var(--spacing-4);
    color: var(--color-gray-500);
    font-size: var(--font-size-sm);
    background: none;
    border: none;
    cursor: pointer;
    transition: color var(--transition-fast);
  }
  
  .main-password__entry-toggle:hover {
    color: var(--color-primary);
  }
  
  .main-password__entry-form {
    margin-top: var(--spacing-4);
    padding: var(--spacing-4);
    background-color: var(--color-white);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-md);
  }
  
  .main-password__form-error {
    margin-top: var(--spacing-4);
    padding: var(--spacing-3);
    background-color: #F8D7DA;
    color: #721C24;
    border-radius: var(--border-radius-md);
    font-size: var(--font-size-sm);
  }
  
  /* Social */
  .main-password__social {
    padding-top: var(--spacing-6);
  }
  
  .main-password__social-text {
    font-size: var(--font-size-sm);
    color: var(--color-gray-500);
    margin-bottom: var(--spacing-4);
  }
  
  .main-password__social .social-icons {
    justify-content: center;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var toggleBtn = document.querySelector('[data-password-toggle]');
    var formContainer = document.getElementById('PasswordFormContainer');
    
    if (toggleBtn && formContainer) {
      toggleBtn.addEventListener('click', function() {
        formContainer.hidden = !formContainer.hidden;
        if (!formContainer.hidden) {
          var passwordInput = formContainer.querySelector('input[type="password"]');
          if (passwordInput) {
            passwordInput.focus();
          }
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Main Password",
  "tag": "section",
  "class": "main-password-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Coming Soon"
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "Message",
      "default": "<p>We're working on something special. Stay tuned for our grand opening!</p>"
    },
    {
      "type": "checkbox",
      "id": "show_email_signup",
      "label": "Show email signup",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Main Password"
    }
  ]
}
{% endschema %}
