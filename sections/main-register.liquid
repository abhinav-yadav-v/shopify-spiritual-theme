{%- comment -%}
  Customer Register Section
  Registration form for new customers.
{%- endcomment -%}

<section class="main-register section">
  <div class="container container--narrow">
    <div class="main-register__wrapper">
      <div class="main-register__header">
        <h1 class="main-register__title">{{ 'customer.register.title' | t }}</h1>
        <p class="main-register__subtitle">{{ 'customer.register.subtitle' | t }}</p>
      </div>
      
      {%- form 'create_customer', class: 'main-register__form' -%}
        {%- if form.errors -%}
          <div class="main-register__error form-error-wrapper">
            <p>{{ form.errors | default_errors }}</p>
          </div>
        {%- endif -%}
        
        <div class="main-register__name-fields">
          <div class="form-group">
            <label for="CustomerFirstName" class="form-label">{{ 'customer.register.first_name' | t }}</label>
            <input
              type="text"
              id="CustomerFirstName"
              class="form-input"
              name="customer[first_name]"
              autocomplete="given-name"
              value="{{ form.first_name }}"
              required
              placeholder="{{ 'customer.register.first_name_placeholder' | t }}"
            >
          </div>
          
          <div class="form-group">
            <label for="CustomerLastName" class="form-label">{{ 'customer.register.last_name' | t }}</label>
            <input
              type="text"
              id="CustomerLastName"
              class="form-input"
              name="customer[last_name]"
              autocomplete="family-name"
              value="{{ form.last_name }}"
              required
              placeholder="{{ 'customer.register.last_name_placeholder' | t }}"
            >
          </div>
        </div>
        
        <div class="form-group">
          <label for="CustomerEmail" class="form-label">{{ 'customer.register.email' | t }}</label>
          <input
            type="email"
            id="CustomerEmail"
            class="form-input"
            name="customer[email]"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            value="{{ form.email }}"
            required
            placeholder="{{ 'customer.register.email_placeholder' | t }}"
          >
        </div>
        
        <div class="form-group">
          <label for="CustomerPassword" class="form-label">{{ 'customer.register.password' | t }}</label>
          <input
            type="password"
            id="CustomerPassword"
            class="form-input"
            name="customer[password]"
            autocomplete="new-password"
            required
            minlength="5"
            placeholder="{{ 'customer.register.password_placeholder' | t }}"
          >
          <small class="main-register__password-hint">{{ 'customer.register.password_hint' | t }}</small>
        </div>
        
        <button type="submit" class="btn btn--primary btn--lg btn--full">
          {{ 'customer.register.submit' | t }}
        </button>
      {%- endform -%}
      
      <div class="main-register__footer">
        <p>{{ 'customer.register.already_have_account' | t }}</p>
        <a href="{{ routes.account_login_url }}" class="main-register__login-link">
          {{ 'customer.register.sign_in' | t }}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .main-register__wrapper {
    max-width: 450px;
    margin: 0 auto;
    background-color: var(--color-white);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--spacing-8);
  }
  
  .main-register__header {
    text-align: center;
    margin-bottom: var(--spacing-6);
  }
  
  .main-register__title {
    margin-bottom: var(--spacing-2);
  }
  
  .main-register__subtitle {
    color: var(--color-gray-600);
    margin-bottom: 0;
  }
  
  .main-register__error {
    background-color: #FEE2E2;
    color: #DC2626;
    padding: var(--spacing-3) var(--spacing-4);
    border-radius: var(--border-radius-md);
    margin-bottom: var(--spacing-4);
    font-size: var(--font-size-sm);
  }
  
  .main-register__name-fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-4);
  }
  
  @media screen and (max-width: 480px) {
    .main-register__name-fields {
      grid-template-columns: 1fr;
    }
  }
  
  .main-register__password-hint {
    display: block;
    margin-top: var(--spacing-1);
    color: var(--color-gray-500);
    font-size: var(--font-size-xs);
  }
  
  .main-register__footer {
    margin-top: var(--spacing-6);
    padding-top: var(--spacing-6);
    border-top: 1px solid var(--color-gray-200);
    text-align: center;
  }
  
  .main-register__footer p {
    color: var(--color-gray-600);
    margin-bottom: var(--spacing-2);
  }
  
  .main-register__login-link {
    font-weight: 600;
    color: var(--color-primary);
  }
  
  .main-register__login-link:hover {
    text-decoration: underline;
  }
</style>

{% schema %}
{
  "name": "Customer Register",
  "tag": "section",
  "class": "main-register-section",
  "settings": [],
  "presets": [
    {
      "name": "Customer Register"
    }
  ]
}
{% endschema %}
