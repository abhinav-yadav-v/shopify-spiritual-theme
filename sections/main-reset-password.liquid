{%- comment -%}
  Reset Password Section
  Form for customers to reset their password.
{%- endcomment -%}

<section class="main-reset section">
  <div class="container container--narrow">
    <div class="main-reset__wrapper">
      <div class="main-reset__header">
        <h1 class="main-reset__title">{{ 'customer.reset_password.title' | t }}</h1>
        <p class="main-reset__subtitle">{{ 'customer.reset_password.subtext' | t }}</p>
      </div>
      
      {%- form 'reset_customer_password', class: 'main-reset__form' -%}
        {%- if form.errors -%}
          <div class="main-reset__error form-error-wrapper">
            <p>{{ form.errors | default_errors }}</p>
          </div>
        {%- endif -%}
        
        <div class="form-group">
          <label for="Password" class="form-label">{{ 'customer.reset_password.password' | t }}</label>
          <input
            type="password"
            id="Password"
            class="form-input"
            name="customer[password]"
            autocomplete="new-password"
            required
            minlength="5"
            placeholder="{{ 'customer.reset_password.password_placeholder' | t }}"
          >
        </div>
        
        <div class="form-group">
          <label for="PasswordConfirmation" class="form-label">{{ 'customer.reset_password.password_confirm' | t }}</label>
          <input
            type="password"
            id="PasswordConfirmation"
            class="form-input"
            name="customer[password_confirmation]"
            autocomplete="new-password"
            required
            minlength="5"
            placeholder="{{ 'customer.reset_password.password_confirm_placeholder' | t }}"
          >
        </div>
        
        <button type="submit" class="btn btn--primary btn--lg btn--full">
          {{ 'customer.reset_password.submit' | t }}
        </button>
      {%- endform -%}
      
      <div class="main-reset__footer">
        <a href="{{ routes.account_login_url }}" class="main-reset__login-link">
          {% render 'icon', name: 'arrow-left', size: 16 %}
          {{ 'customer.reset_password.back_to_login' | t }}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .main-reset__wrapper {
    max-width: 450px;
    margin: 0 auto;
    background-color: var(--color-white);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--spacing-8);
  }
  
  .main-reset__header {
    text-align: center;
    margin-bottom: var(--spacing-6);
  }
  
  .main-reset__title {
    margin-bottom: var(--spacing-2);
  }
  
  .main-reset__subtitle {
    color: var(--color-gray-600);
    margin-bottom: 0;
  }
  
  .main-reset__error {
    background-color: #FEE2E2;
    color: #DC2626;
    padding: var(--spacing-3) var(--spacing-4);
    border-radius: var(--border-radius-md);
    margin-bottom: var(--spacing-4);
    font-size: var(--font-size-sm);
  }
  
  .main-reset__footer {
    margin-top: var(--spacing-6);
    padding-top: var(--spacing-6);
    border-top: 1px solid var(--color-gray-200);
    text-align: center;
  }
  
  .main-reset__login-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    color: var(--color-gray-600);
  }
  
  .main-reset__login-link:hover {
    color: var(--color-primary);
  }
</style>

{% schema %}
{
  "name": "Reset Password",
  "tag": "section",
  "class": "main-reset-section",
  "settings": [],
  "presets": [
    {
      "name": "Reset Password"
    }
  ]
}
{% endschema %}
