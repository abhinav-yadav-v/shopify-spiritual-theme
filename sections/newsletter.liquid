{%- comment -%}
  Newsletter Section
  Email signup form with customizable background and content.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign placeholder_text = section.settings.placeholder_text | default: 'Enter your email'
  assign button_text = section.settings.button_text | default: 'Subscribe'
  assign success_message = section.settings.success_message | default: 'Thank you for subscribing!'
  assign bg_image = section.settings.background_image
  assign bg_color = section.settings.background_color
  assign text_color = section.settings.text_color
-%}

<section 
  class="newsletter section"
  {% if bg_color != blank and bg_color != 'rgba(0,0,0,0)' %}style="--newsletter-bg: {{ bg_color }}; --newsletter-text: {{ text_color }};"{% endif %}
>
  {%- if bg_image != blank -%}
    <div class="newsletter__background">
      <img
        class="newsletter__bg-image"
        src="{{ bg_image | image_url: width: 1920 }}"
        alt=""
        width="{{ bg_image.width }}"
        height="{{ bg_image.height }}"
        loading="lazy"
      >
      <div class="newsletter__overlay"></div>
    </div>
  {%- endif -%}

  <div class="newsletter__content container">
    <div class="newsletter__inner">
      {%- if heading != blank -%}
        <h2 class="newsletter__heading">{{ heading }}</h2>
      {%- endif -%}
      
      {%- if description != blank -%}
        <div class="newsletter__description rte">
          {{ description }}
        </div>
      {%- endif -%}

      {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        {%- if form.errors -%}
          <div class="newsletter__error" role="alert">
            {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <p class="newsletter__success" role="status">
            {% render 'icon', name: 'check', size: 20 %}
            {{ success_message }}
          </p>
        {%- else -%}
          <div class="newsletter__form-fields">
            <div class="newsletter__input-wrapper">
              <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">
                {{ 'general.newsletter.email' | t | default: 'Email address' }}
              </label>
              <input
                type="email"
                name="contact[email]"
                id="NewsletterEmail-{{ section.id }}"
                class="newsletter__input form-input"
                placeholder="{{ placeholder_text }}"
                required
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="NewsletterError-{{ section.id }}"
                {% endif %}
              >
            </div>
            <button type="submit" class="newsletter__submit btn btn--primary">
              {{ button_text }}
            </button>
          </div>
          
          <p class="newsletter__disclaimer">
            {{ 'general.newsletter.disclaimer' | t | default: "By subscribing, you agree to receive marketing emails. Unsubscribe anytime." }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe to Our Newsletter"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Stay updated with our latest products, offers, and spiritual insights. Join our community today!</p>"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Email placeholder text",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for subscribing! Welcome to our community."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#8B0000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "settings": {
        "heading": "Join Our Spiritual Community",
        "description": "<p>Subscribe to receive updates on new arrivals, special offers, and spiritual wisdom delivered to your inbox.</p>",
        "button_text": "Subscribe",
        "background_color": "#8B0000",
        "text_color": "#FFFFFF"
      }
    }
  ]
}
{% endschema %}
