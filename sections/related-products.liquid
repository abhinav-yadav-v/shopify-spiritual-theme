{%- comment -%}
  Related Products Section
  Displays recommended products using Shopify's product recommendations API
  or falls back to products from a selected collection.
{%- endcomment -%}

{%- liquid
  assign products_to_show = section.settings.products_to_show | default: 4
  assign heading = section.settings.heading | default: 'You may also like'
  assign fallback_collection = section.settings.collection
-%}

<section class="related-products section" data-related-products data-product-id="{{ product.id }}" data-limit="{{ products_to_show }}">
  <div class="container">
    {%- if heading != blank -%}
      <div class="section__header">
        <h2 class="section__title">{{ heading }}</h2>
      </div>
    {%- endif -%}
    
    <div class="related-products__grid grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4" data-related-products-grid>
      {%- comment -%} Server-side fallback - shows products from collection if no JS or recommendations fail {%- endcomment -%}
      {%- if fallback_collection != blank and fallback_collection.products.size > 0 -%}
        {%- for product in fallback_collection.products limit: products_to_show -%}
          <div class="related-products__item">
            {% render 'product-card', product: product, show_vendor: false %}
          </div>
        {%- endfor -%}
      {%- elsif recommendations.performed and recommendations.products_count > 0 -%}
        {%- for product in recommendations.products limit: products_to_show -%}
          <div class="related-products__item">
            {% render 'product-card', product: product, show_vendor: false %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Placeholder for when JS loads recommendations {%- endcomment -%}
        <div class="related-products__placeholder" data-related-placeholder>
          <p class="related-products__loading">{{ 'products.loading_recommendations' | t }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .related-products {
    padding-top: var(--spacing-12);
    padding-bottom: var(--spacing-12);
    background-color: var(--color-gray-50);
  }
  
  .related-products__grid {
    gap: var(--spacing-4);
  }
  
  .related-products__item {
    opacity: 0;
    animation: fadeInUp 0.4s ease forwards;
  }
  
  .related-products__item:nth-child(1) { animation-delay: 0.1s; }
  .related-products__item:nth-child(2) { animation-delay: 0.15s; }
  .related-products__item:nth-child(3) { animation-delay: 0.2s; }
  .related-products__item:nth-child(4) { animation-delay: 0.25s; }
  .related-products__item:nth-child(5) { animation-delay: 0.3s; }
  .related-products__item:nth-child(6) { animation-delay: 0.35s; }
  .related-products__item:nth-child(7) { animation-delay: 0.4s; }
  .related-products__item:nth-child(8) { animation-delay: 0.45s; }
  
  .related-products__placeholder {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--spacing-8);
  }
  
  .related-products__loading {
    color: var(--color-gray-500);
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

{% schema %}
{
  "name": "Related Products",
  "tag": "section",
  "class": "related-products-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback collection",
      "info": "Used if product recommendations are not available."
    }
  ],
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}
