{%- comment -%}
  Testimonials Section
  Customer reviews displayed as carousel or grid with star ratings.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign layout = section.settings.layout | default: 'carousel'
  assign columns = section.settings.columns | default: 3
  assign autoplay = section.settings.autoplay
  assign bg_color = section.settings.background_color
  assign testimonials_id = 'Testimonials-' | append: section.id
-%}

<section 
  class="testimonials section"
  id="{{ testimonials_id }}"
  {% if bg_color != blank and bg_color != 'rgba(0,0,0,0)' %}style="background-color: {{ bg_color }};"{% endif %}
>
  <div class="container">
    {%- if heading != blank -%}
      <div class="section__header text-center">
        <h2 class="section__title">{{ heading }}</h2>
      </div>
    {%- endif -%}

    {%- if layout == 'carousel' -%}
      <div 
        class="testimonials__carousel"
        data-testimonial-carousel
        data-autoplay="{{ autoplay }}"
      >
        <div class="testimonials__track">
          {%- for block in section.blocks -%}
            {%- liquid
              assign rating = block.settings.rating | default: 5
              assign reviewer_name = block.settings.reviewer_name
              assign review_date = block.settings.review_date
              assign review_text = block.settings.review_text
              assign reviewer_image = block.settings.reviewer_image
              assign show_verified = block.settings.show_verified
            -%}
            <div 
              class="testimonials__item testimonial-card"
              {{ block.shopify_attributes }}
            >
              <div class="testimonial-card__inner">
                <div class="testimonial-card__rating">
                  {% render 'rating-stars', rating: rating %}
                </div>
                
                {%- if review_text != blank -%}
                  <blockquote class="testimonial-card__quote">
                    <p>{{ review_text }}</p>
                  </blockquote>
                {%- endif -%}
                
                <div class="testimonial-card__author">
                  {%- if reviewer_image != blank -%}
                    <div class="testimonial-card__avatar">
                      <img
                        src="{{ reviewer_image | image_url: width: 80 }}"
                        alt="{{ reviewer_name | escape }}"
                        width="40"
                        height="40"
                        loading="lazy"
                      >
                    </div>
                  {%- else -%}
                    <div class="testimonial-card__avatar testimonial-card__avatar--placeholder">
                      <span>{{ reviewer_name | slice: 0 | upcase }}</span>
                    </div>
                  {%- endif -%}
                  
                  <div class="testimonial-card__author-info">
                    <p class="testimonial-card__name">
                      {{ reviewer_name | default: 'Happy Customer' }}
                      {%- if show_verified -%}
                        <span class="testimonial-card__verified" title="{{ 'sections.testimonials.verified_buyer' | t | default: 'Verified Buyer' }}">
                          {% render 'icon', name: 'check', size: 14 %}
                        </span>
                      {%- endif -%}
                    </p>
                    {%- if review_date != blank -%}
                      <p class="testimonial-card__date">{{ review_date }}</p>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          {%- else -%}
            {%- comment -%} Default testimonials when no blocks exist {%- endcomment -%}
            {%- for i in (1..3) -%}
              <div class="testimonials__item testimonial-card">
                <div class="testimonial-card__inner">
                  <div class="testimonial-card__rating">
                    {% render 'rating-stars', rating: 5 %}
                  </div>
                  <blockquote class="testimonial-card__quote">
                    <p>Amazing products with excellent quality. The delivery was fast and the packaging was beautiful. Highly recommended!</p>
                  </blockquote>
                  <div class="testimonial-card__author">
                    <div class="testimonial-card__avatar testimonial-card__avatar--placeholder">
                      <span>C</span>
                    </div>
                    <div class="testimonial-card__author-info">
                      <p class="testimonial-card__name">Customer {{ i }}</p>
                      <p class="testimonial-card__date">Recently</p>
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>

        {%- if section.blocks.size > 1 -%}
          <div class="testimonials__nav">
            <button 
              type="button" 
              class="testimonials__nav-btn testimonials__nav-btn--prev"
              data-testimonial-prev
              aria-label="{{ 'sections.testimonials.previous' | t | default: 'Previous testimonial' }}"
            >
              {% render 'icon', name: 'chevron-left', size: 24 %}
            </button>
            <button 
              type="button" 
              class="testimonials__nav-btn testimonials__nav-btn--next"
              data-testimonial-next
              aria-label="{{ 'sections.testimonials.next' | t | default: 'Next testimonial' }}"
            >
              {% render 'icon', name: 'chevron-right', size: 24 %}
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      {%- comment -%} Grid layout {%- endcomment -%}
      <div class="testimonials__grid grid" style="--columns: {{ columns }};">
        {%- for block in section.blocks -%}
          {%- liquid
            assign rating = block.settings.rating | default: 5
            assign reviewer_name = block.settings.reviewer_name
            assign review_date = block.settings.review_date
            assign review_text = block.settings.review_text
            assign reviewer_image = block.settings.reviewer_image
            assign show_verified = block.settings.show_verified
          -%}
          <div 
            class="testimonials__item testimonial-card"
            {{ block.shopify_attributes }}
          >
            <div class="testimonial-card__inner">
              <div class="testimonial-card__rating">
                {% render 'rating-stars', rating: rating %}
              </div>
              
              {%- if review_text != blank -%}
                <blockquote class="testimonial-card__quote">
                  <p>{{ review_text }}</p>
                </blockquote>
              {%- endif -%}
              
              <div class="testimonial-card__author">
                {%- if reviewer_image != blank -%}
                  <div class="testimonial-card__avatar">
                    <img
                      src="{{ reviewer_image | image_url: width: 80 }}"
                      alt="{{ reviewer_name | escape }}"
                      width="40"
                      height="40"
                      loading="lazy"
                    >
                  </div>
                {%- else -%}
                  <div class="testimonial-card__avatar testimonial-card__avatar--placeholder">
                    <span>{{ reviewer_name | slice: 0 | upcase }}</span>
                  </div>
                {%- endif -%}
                
                <div class="testimonial-card__author-info">
                  <p class="testimonial-card__name">
                    {{ reviewer_name | default: 'Happy Customer' }}
                    {%- if show_verified -%}
                      <span class="testimonial-card__verified" title="{{ 'sections.testimonials.verified_buyer' | t | default: 'Verified Buyer' }}">
                        {% render 'icon', name: 'check', size: 14 %}
                      </span>
                    {%- endif -%}
                  </p>
                  {%- if review_date != blank -%}
                    <p class="testimonial-card__date">{{ review_date }}</p>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (grid layout)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay carousel",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer name",
          "default": "Happy Customer"
        },
        {
          "type": "text",
          "id": "review_date",
          "label": "Review date",
          "default": "Recently"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review text",
          "default": "Excellent quality products and amazing customer service. I'm very happy with my purchase!"
        },
        {
          "type": "image_picker",
          "id": "reviewer_image",
          "label": "Reviewer image"
        },
        {
          "type": "checkbox",
          "id": "show_verified",
          "label": "Show verified badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "reviewer_name": "Priya Sharma",
            "review_date": "2 weeks ago",
            "rating": 5,
            "review_text": "The idol I received was absolutely beautiful. The craftsmanship is exceptional and it arrived well-packaged. Truly blessed to have it in my home temple.",
            "show_verified": true
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "reviewer_name": "Rajesh Kumar",
            "review_date": "1 month ago",
            "rating": 5,
            "review_text": "Fast delivery and authentic products. The puja items are of high quality. Will definitely order again for all my spiritual needs.",
            "show_verified": true
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "reviewer_name": "Meera Patel",
            "review_date": "3 weeks ago",
            "rating": 5,
            "review_text": "I ordered a complete puja thali set and it exceeded my expectations. Beautiful design and great value for money. Highly recommended!",
            "show_verified": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
